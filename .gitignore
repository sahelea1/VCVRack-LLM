# Ignore all dotfiles except git dotfiles
.*
!.git*

# Binaries and build targets
*.a
*.so
*.dylib
*.dll
*.exe
*.res
*.d
*.dSYM
*.vcvplugin
/build
/Rack
/dep
/dist

# Rack folders
/plugins
/disabledplugins
/patches
/presets
/licenses
/autosave
/settings.json
/screenshots
/selections

# Assistant files (dev mode puts the user dir in the repo root)
/assistant.json
/assistant.json.tmp
/assistant-system-prompt.md
/assistant-mock.json
/assistant-selftest*
